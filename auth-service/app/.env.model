#renane this file to .env
#set the values of the variables to the values of the variables in the snippet above

SQLITE_DATABASE_NAME=usersDB #this is the name of the database
BACKEND_SERVER_SSH_PORT=4433 #this is the port number
BACKEND_SERVER_NAME_API=localhost #this is the HOST name of the server

#passport
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://localhost:4433/api/auth/google/callback


FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET=YOUR_FACEBOOK_CLIENT_SECRET
FACEBOOK_CALLBACK_URL=https://localhost:4433/api/auth/facebook/callback

GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=https://localhost:4433/api/auth/github/callback

API42_CLIENT_ID=YOUR_API42_CLIENT_ID
API42_CLIENT_SECRET=YOUR_API42_CLIENT_SECRET
API42_REDIRECT_URI=https://localhost:4433/api/auth/42api/callback
