#renane this file to .env
# the dotenvPlugin will load the variables from this file into the environment
# the placeholder 'BACKEND_SERVER_URL' will be replaced by the value of 
#    the variable 'BACKEND_SERVER_URL' from the docker-compose.yml  
#  in the docker-compose.yml file
#   environment:
#      - BACKEND_SERVER_URL=${BACKEND_SERVER_BASE_URL}  // from the main .env file
#set the values of the variables to the values of the variables in the snippet above

SQLITE_DATABASE_URL=http://database-services:3000/api/v2/database

#cryptography
#  the encryption key is used to encrypt the 2fa codes in the database
#  the key must be 32 bytes long

ENCRYPTION_KEY='def_32_byte_key_1234567890123456'
#service de messagerie
MAIL_HOST="MAIL_HOST"
MAIL_USER="MAIL_USER"
MAIL_PASS="MAIL_PASS"

#BACKEND_SERVER_SSH_PORT=4433 #this is the port number
#BACKEND_SERVER_NAME_API=localhost #this is the HOST name of the server

#passport
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=BACKEND_SERVER_URL/api/auth/google/callback


FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET=YOUR_FACEBOOK_CLIENT_SECRET
FACEBOOK_CALLBACK_URL=BACKEND_SERVER_URL/api/auth/facebook/callback

GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=BACKEND_SERVER_URL/api/auth/github/callback

API42_CLIENT_ID=YOUR_API42_CLIENT_ID
API42_CLIENT_SECRET=YOUR_API42_CLIENT_SECRET
API42_REDIRECT_URI=BACKEND_SERVER_URL/api/auth/42api/callback
