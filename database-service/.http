### create a new User
POST https://localhost:4433/api/v2/database/myDb/table/user HTTP/1.1
Content-Type: application/json

{

"email": "123@mail.com",
"name": "12345678",
 "authProviders": [
    { "provider": "google", "provider_id": "12345" },
    { "provider": "github", "provider_id": "67890" }
  ]
}
### create a new User
GET https://localhost:4433/api/v2/database/myDb/table/user/id/3?relations=authProviders HTTP/1.1
###
PUT https://localhost:4433/api/v2/database/myDb/table/user/id/3?relations=authProviders HTTP/1.1
Content-Type: application/json

{
"email": "test11@mail.com",
"name": "123478",
"authProviders": [
    {"id": 33, "provider": "google", "provider_id": "12345", "user_id": 3 },
    {"id": 34, "provider": "google", "provider_id": "12345", "user_id": 3 },
    {"provider": "google", "provider_id": "12345", "user_id": 3 },
    {"id": 32,"provider": "google", "provider_id": "12345", "user_id": 3 }
]
}
