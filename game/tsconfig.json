{
	"compilerOptions": {
	  "target": "ES6",
	  "module": "ES6",
	  "strict": true,
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "forceConsistentCasingInFileNames": true,
	  "outDir": "./dist",  // Dossier de sortie pour les fichiers JS compilés
	  "rootDir": "./src"  // Le répertoire où se trouvent tes fichiers TypeScript
	},
	"include": ["src"],  // Inclure tous les fichiers .ts dans ce répertoire
	"exclude": ["node_modules"]
}