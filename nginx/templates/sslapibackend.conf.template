
# Configuration pour <domain> avec SSL
server {
    listen 443 ssl;

    server_name ${BACKEND_SERVER_NAME};
    server_tokens off;

    #root /var/www/html;
    #index index.js index.html index.htm;

    #add_header 'X-Content-Type-Options' 'nosniff';
    #add_header 'X-Frame-Options' 'sameorigin';
    #add_header 'X-XSS-Protection' '1; mode=block';
    #add_header 'Strict-Transport-Security' 'max-age=31536000; includeSubDomains; preload';
    #add_header 'Cache-control' 'no-cache';
    #add_header 'Content-Security-Policy' "default-src 'self'; font-src 'self'; img-src 'self'; script-src 'self'; style-src 'self'; frame-src 'self'";
    #add_header 'Permissions-Policy' 'camera=(), geolocation=(), microphone=()';
    #add_header 'Referrer-Policy' 'same-origin';
    add_header 'Content-Security-Policy' "img-src 'self' blob: https://lh3.googleusercontent.com https://avatars.githubusercontent.com https://cdn.intra.42.fr";
    

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/nginx/ssl/transcendence.crt;
    ssl_certificate_key /etc/nginx/ssl/transcendence.key;

    location /uploads/ {        
        root /usr/share/nginx/html;
        autoindex on;
    }
    #include all proxy configuration location
    include /etc/nginx/conf/configProxy/*.conf;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
}
